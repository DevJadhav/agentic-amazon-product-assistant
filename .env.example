# =============================================================================
# Amazon Electronics Assistant - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (Required - Choose at least one)
# -----------------------------------------------------------------------------

# OpenAI API Key (Recommended for best performance)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional - Fast inference with Llama models)
GROQ_API_KEY=your_groq_api_key_here

# Google AI API Key (Optional - Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LangSmith Tracing (Optional - For monitoring and debugging)
# -----------------------------------------------------------------------------

# LangSmith API Key
LANGSMITH_API_KEY=your_langsmith_key_here

# LangSmith Project Name
LANGSMITH_PROJECT=amazon-electronics-assistant

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Weaviate Configuration (for Docker deployment)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# PostgreSQL Configuration (for LangGraph and Shopping Cart)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=langgraph_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Redis Configuration (for caching and session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Enable CORS for web applications
API_ENABLE_CORS=true

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=INFO

# Caching Configuration
ENABLE_CACHING=true

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_STRUCTURED_OUTPUTS=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true

# -----------------------------------------------------------------------------
# Shopping Cart Configuration
# -----------------------------------------------------------------------------

# Shopping cart functionality
SHOPPING_CART_ENABLED=true
SHOPPING_CART_SESSION_TIMEOUT=86400  # 24 hours in seconds
SHOPPING_CART_MAX_ITEMS=100
SHOPPING_CART_CLEANUP_INTERVAL=3600  # 1 hour in seconds

# Cart database settings
SHOPPING_CART_DB_POOL_SIZE=10
SHOPPING_CART_DB_MAX_OVERFLOW=20
SHOPPING_CART_DB_TIMEOUT=30

# -----------------------------------------------------------------------------
# Router Configuration
# -----------------------------------------------------------------------------

# Intent classification and routing
ROUTER_INTENT_CONFIDENCE_THRESHOLD=0.7
ROUTER_CACHE_ENABLED=true
ROUTER_CACHE_TTL=300  # 5 minutes in seconds
ROUTER_MAX_CLARIFICATION_ATTEMPTS=3

# Router performance settings
ROUTER_CLASSIFICATION_TIMEOUT=5  # seconds
ROUTER_ENABLE_FALLBACK=true
ROUTER_FALLBACK_AGENT=qa

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------

# Default search parameters
DEFAULT_MAX_PRODUCTS=5
DEFAULT_MAX_REVIEWS=3

# Hybrid search weights
SEMANTIC_SEARCH_WEIGHT=0.7
KEYWORD_SEARCH_WEIGHT=0.3

# Re-ranking configuration
RERANK_TOP_K=10
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------

# LLM Response Configuration
MAX_TOKENS_DEFAULT=512
TEMPERATURE_DEFAULT=0.7

# Vector Database Settings
VECTOR_CACHE_SIZE=1000
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# API Key for internal services (if needed)
INTERNAL_API_KEY=your_internal_api_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# -----------------------------------------------------------------------------
# Monitoring and Analytics
# -----------------------------------------------------------------------------

# Enable performance tracking
ENABLE_PERFORMANCE_TRACKING=true

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Shopping cart and router monitoring
ENABLE_CART_METRICS=true
ENABLE_ROUTER_METRICS=true
ENABLE_INTENT_CLASSIFICATION_METRICS=true

# Metrics collection settings
METRICS_COLLECTION_INTERVAL=60  # seconds
METRICS_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Docker-specific Configuration
# -----------------------------------------------------------------------------

# Docker network settings
DOCKER_NETWORK=amazon-assistant-network

# Volume mounts for data persistence
DATA_VOLUME_PATH=./data

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Custom prompt template directory
CUSTOM_PROMPT_TEMPLATES_DIR=./custom_prompts

# Evaluation dataset path
EVALUATION_DATASET_PATH=./data/evaluation/rag_evaluation_dataset.json

# Model download cache directory
MODEL_CACHE_DIR=./models

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Enable debug mode (development only)
DEBUG_MODE=false

# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Enable detailed error messages (development only)
DETAILED_ERRORS=true 